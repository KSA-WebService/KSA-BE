// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ======================================================
// Enums
// ======================================================

enum UserRole {
  STUDENT @map("student")
  ADMIN   @map("admin")

  @@map("user_role")
}

enum UserStatus {
  ACTIVE  @map("active")
  BLOCKED @map("blocked")

  @@map("user_status")
}

enum WhitelistInvitationStatus {
  PENDING  @map("pending")
  INVITED  @map("invited")
  ACCEPTED @map("accepted")
  EXPIRED  @map("expired")
  FAILED   @map("failed")

  @@map("whitelist_invitation_status")
}

enum InvitationLinkStatus {
  ACTIVE   @map("active")
  ACCEPTED @map("accepted")
  EXPIRED  @map("expired")
  REVOKED  @map("revoked")
  FAILED   @map("failed")

  @@map("invitation_link_status")
}

enum PublicationStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  HIDDEN    @map("hidden")

  @@map("publication_status")
}

enum ContentPostType {
  PARTNERSHIP  @map("partnership")
  EVENT        @map("event")
  CO_PURCHASE  @map("co-purchase")
  CAREER       @map("career")
  ANNOUNCEMENT @map("announcement")
  KSA          @map("KSA")

  @@map("content_post_type")
}

enum FileStatus {
  DELETED   @map("deleted")
  PENDING   @map("pending")
  COMPLETED @map("completed")
  FAILED    @map("failed")

  @@map("file_status")
}

enum FilePurpose {
  POST_IMAGE         @map("post image")
  PRODUCT_IMAGE      @map("product image")
  GENERAL_ATTACHMENT @map("general attachment")

  @@map("file_purpose")
}

enum OrderStatus {
  ORDERED   @map("ordered")
  ACCEPTED  @map("accepted")
  DELIVERED @map("delivered")

  @@map("order_status")
}

enum TokenTransactionType {
  EVENT_GRANT      @map("event_grant")
  EVENT_ADJUSTMENT @map("event_adjustment")
  ORDER_PAYMENT    @map("order_payment")
  RESET            @map("reset")

  @@map("token_transaction_type")
}

enum AdminActionType {
  USER       @map("user")
  WHITELIST  @map("whitelist")
  INVITATION @map("invitation")
  CONTENT    @map("content")
  PRODUCT    @map("product")
  ORDER      @map("order")
  TOKEN      @map("token")
  MEMO       @map("memo")

  @@map("admin_action_type")
}

enum AdminAction {
  UPDATE_USER_ROLE                  @map("update_user_role")
  UPDATE_USER_STATUS                @map("update_user_status")
  CREATE_WHITELIST_USER             @map("create_whitelist_user")
  IMPORT_WHITELIST_USERS            @map("import_whitelist_users")
  DELETE_WHITELIST_USER             @map("delete_whitelist_user")
  SEND_INVITATION                   @map("send_invitation")
  RESEND_INVITATION                 @map("resend_invitation")
  CREATE_CONTENT_POST               @map("create_content_post")
  UPDATE_CONTENT_POST               @map("update_content_post")
  UPDATE_CONTENT_POST_STATUS        @map("update_content_post_status")
  DELETE_CONTENT_POST               @map("delete_content_post")
  CREATE_PRODUCT                    @map("create_product")
  UPDATE_PRODUCT                    @map("update_product")
  UPDATE_PRODUCT_PUBLICATION_STATUS @map("update_product_publication_status")
  DELETE_PRODUCT                    @map("delete_product")
  UPDATE_ORDER_STATUS               @map("update_order_status")
  CREATE_TOKEN_EVENT                @map("create_token_event")
  UPDATE_TOKEN_EVENT                @map("update_token_event")
  GRANT_TOKEN                       @map("grant_token")
  UPDATE_TOKEN_GRANT                @map("update_token_grant")
  SAVE_TOKEN_GRANTS                 @map("save_token_grants")
  RESET_TOKEN_BALANCES              @map("reset_token_balances")
  DELETE_TOKEN_EVENT                @map("delete_token_event")
  UPDATE_MEMO                       @map("update_memo")

  @@map("admin_action")
}

// ======================================================
// Models
// ======================================================

model User {
  id            String     @id @map("id") @db.Uuid
  name          String     @map("name") @db.VarChar(128)
  email         String     @unique @map("email") @db.VarChar(255)
  studentNumber String     @unique @map("student_number") @db.VarChar(36)
  role          UserRole   @default(STUDENT) @map("role")
  status        UserStatus @default(ACTIVE) @map("status")
  tokenBalance  Int        @default(0) @map("token_balance")
  createdAt     DateTime   @default(now()) @map("created_at")
  deletedAt     DateTime?  @map("deleted_at")
  agreedPrivacy Boolean    @default(false) @map("agreed_privacy")
  agreedAt      DateTime?  @map("agreed_at")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at")

  orders       Order[]
  contentPosts ContentPost[]

  whitelistedAccount WhitelistedUser?  @relation("WhitelistAccount")
  invitedWhitelists  WhitelistedUser[] @relation("WhitelistInviter")
  sentInvitations    Invitation[]      @relation("InvitationSender")
  uploadedFiles      File[]            @relation("FileUploader")

  changedOrderLogs OrderStatusLog[] @relation("OrderStatusLogChanger")
  adminActionLogs  AdminActionLog[] @relation("AdminActionLogAdmin")

  tokenLogsAsAdmin   TokenLog[]   @relation("TokenLogAdmin")
  tokenLogsAsUser    TokenLog[]   @relation("TokenLogUser")
  tokenGrantsAsAdmin TokenGrant[] @relation("TokenGrantAdmin")
  tokenGrantsAsUser  TokenGrant[] @relation("TokenGrantUser")
  createdTokenEvents TokenEvent[] @relation("TokenEventCreator")

  updatedAdminMemos AdminMemo[] @relation("AdminMemoUpdater")

  @@map("users")
}

model WhitelistedUser {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId           String?                   @unique @map("user_id") @db.Uuid
  email            String                    @unique @map("email") @db.VarChar(255)
  name             String                    @map("name") @db.VarChar(36)
  studentNumber    String                    @unique @map("student_number") @db.VarChar(36)
  invitationStatus WhitelistInvitationStatus @default(PENDING) @map("invitation_status")
  invitedBy        String?                   @map("invited_by") @db.Uuid
  invitedAt        DateTime?                 @map("invited_at")
  acceptedAt       DateTime?                 @map("accepted_at")
  updatedAt        DateTime                  @default(now()) @updatedAt @map("updated_at")
  createdAt        DateTime                  @default(now()) @map("created_at")

  user    User? @relation("WhitelistAccount", fields: [userId], references: [id], onDelete: SetNull)
  inviter User? @relation("WhitelistInviter", fields: [invitedBy], references: [id], onDelete: SetNull)

  invitations Invitation[]

  @@index([invitationStatus])
  @@index([invitedBy])
  @@map("whitelisted_users")
}

model Invitation {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  whitelistUserId String               @map("whitelist_user_id") @db.Uuid
  sentBy          String?              @map("sent_by") @db.Uuid
  tokenHash       String               @unique @map("token_hash") @db.VarChar(255)
  linkStatus      InvitationLinkStatus @default(ACTIVE) @map("link_status")
  sentAt          DateTime             @map("sent_at")
  expiresAt       DateTime             @map("expires_at")
  acceptedAt      DateTime?            @map("accepted_at")
  createdAt       DateTime             @default(now()) @map("created_at")

  whitelistUser WhitelistedUser @relation(fields: [whitelistUserId], references: [id], onDelete: Cascade)
  sender        User?           @relation("InvitationSender", fields: [sentBy], references: [id], onDelete: SetNull)

  @@index([whitelistUserId])
  @@index([sentBy])
  @@index([linkStatus])
  @@index([expiresAt])
  @@map("invitations")
}

model File {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  uploadedBy   String?     @map("uploaded_by") @db.Uuid
  originalName String      @map("original_name") @db.VarChar(255)
  storagePath  String      @map("storage_path") @db.Text
  fileUrl      String      @map("file_url") @db.Text
  contentType  String      @map("content_type") @db.VarChar(128)
  fileSize     Int         @map("file_size")
  purpose      FilePurpose @map("purpose")
  status       FileStatus  @default(PENDING) @map("status")
  createdAt    DateTime    @default(now()) @map("created_at")
  deletedAt    DateTime?   @map("deleted_at")

  uploader User? @relation("FileUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)

  products      Product[]
  contentImages ContentImage[]

  @@index([uploadedBy])
  @@index([status])
  @@index([purpose])
  @@map("files")
}

model Product {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  name              String            @map("name") @db.VarChar(100)
  description       String?           @map("description") @db.Text
  price             Int               @map("price")
  stockQuantity     Int               @default(0) @map("stock_quantity")
  imageFileId       String?           @map("image_file_id") @db.Uuid
  publicationStatus PublicationStatus @default(DRAFT) @map("publication_status")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")

  imageFile File? @relation(fields: [imageFileId], references: [id], onDelete: SetNull)

  orders Order[]

  @@index([imageFileId])
  @@index([publicationStatus])
  @@map("products")
}

model Order {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  productId   String      @map("product_id") @db.Uuid
  quantity    Int         @map("quantity")
  unitPrice   Int         @map("unit_price")
  totalAmount Int         @map("total_amount")
  status      OrderStatus @default(ORDERED) @map("status")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at")
  acceptedAt  DateTime?   @map("accepted_at")
  deliveredAt DateTime?   @map("delivered_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  statusLogs OrderStatusLog[]
  tokenLog   TokenLog?

  @@index([userId])
  @@index([productId])
  @@index([status])
  @@map("orders")
}

model OrderStatusLog {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  changedBy    String      @map("changed_by") @db.Uuid
  orderId      String      @map("order_id") @db.Uuid
  beforeStatus OrderStatus @map("before_status")
  afterStatus  OrderStatus @map("after_status")
  createdAt    DateTime    @default(now()) @map("created_at")

  changer User  @relation("OrderStatusLogChanger", fields: [changedBy], references: [id], onDelete: Restrict)
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([changedBy])
  @@index([orderId])
  @@map("order_status_logs")
}

model ContentPost {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  authorId       String            @map("author_id") @db.Uuid
  type           ContentPostType   @map("type")
  title          String            @map("title") @db.VarChar(255)
  content        String?           @map("content") @db.Text
  status         PublicationStatus @default(DRAFT) @map("status")
  publishedAt    DateTime?         @map("published_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")
  eventStartDate DateTime?         @map("event_start_date") @db.Date
  eventEndDate   DateTime?         @map("event_end_date") @db.Date
  showOnCalendar Boolean           @default(false) @map("show_on_calendar")
  deletedAt      DateTime?         @map("deleted_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  images ContentImage[]

  @@index([authorId])
  @@index([type])
  @@index([status])
  @@index([showOnCalendar, eventStartDate])
  @@map("content_posts")
}

model ContentImage {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  contentPostId String   @map("content_post_id") @db.Uuid
  fileId        String   @map("file_id") @db.Uuid
  sortOrder     Int      @default(1) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  post ContentPost @relation(fields: [contentPostId], references: [id], onDelete: Cascade)
  file File        @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([contentPostId])
  @@index([fileId])
  @@map("content_images")
}

model Club {
  id           Int       @id @default(autoincrement()) @map("id")
  name         String    @map("name") @db.VarChar(128)
  category     String?   @map("category") @db.VarChar(36)
  description  String?   @map("description") @db.Text
  instagramUrl String?   @map("instagram_url") @db.Text
  contactUrl   String?   @map("contact_url") @db.Text
  imageUrl     String?   @map("image_url") @db.Text
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime? @map("updated_at")
  leader       String?   @map("leader") @db.VarChar(128)
  viceLeader   String?   @map("vice_leader") @db.VarChar(128)

  @@index([isActive])
  @@map("clubs")
}

model AdminMemo {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  content   String?  @map("content") @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  updater User? @relation("AdminMemoUpdater", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([updatedBy])
  @@map("admin_memos")
}

model AdminActionLog {
  id         Int             @id @default(autoincrement()) @map("id")
  adminId    String          @map("admin_id") @db.Uuid
  actionType AdminActionType @map("action_type")
  targetId   String?         @map("target_id") @db.VarChar(128)
  action     AdminAction     @map("action")
  createdAt  DateTime        @default(now()) @map("created_at")
  metadata   Json?           @map("metadata") @db.JsonB

  admin User @relation("AdminActionLogAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([actionType, targetId])
  @@map("admin_action_logs")
}

model TokenEvent {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  createdBy String    @map("created_by") @db.Uuid
  eventName String    @map("event_name") @db.VarChar(128)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  creator User @relation("TokenEventCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  tokenGrants TokenGrant[]

  @@index([createdBy])
  @@index([deletedAt])
  @@map("token_events")
}

model TokenGrant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  tokenEventId  String   @map("token_event_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  grantedBy     String   @map("granted_by") @db.Uuid
  grantedAmount Int      @map("granted_amount")
  reason        String   @map("reason") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  tokenEvent TokenEvent @relation(fields: [tokenEventId], references: [id], onDelete: Restrict)

  user User @relation("TokenGrantUser", fields: [userId], references: [id], onDelete: Restrict)

  admin User @relation("TokenGrantAdmin", fields: [grantedBy], references: [id], onDelete: Restrict)

  tokenLogs TokenLog[]

  @@unique([tokenEventId, userId])
  @@index([userId])
  @@index([grantedBy])
  @@index([tokenEventId, grantedAmount])
  @@map("token_grants")
}

model TokenLog {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  transactionType TokenTransactionType @map("transaction_type")
  adminId         String?              @map("admin_id") @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  tokenGrantId    String?              @map("token_grant_id") @db.Uuid
  orderId         String?              @unique @map("order_id") @db.Uuid
  balanceBefore   Int                  @map("balance_before")
  balanceAfter    Int                  @map("balance_after")
  delta           Int                  @map("delta")
  reason          String               @map("reason") @db.Text
  createdAt       DateTime             @default(now()) @map("created_at")

  admin User? @relation("TokenLogAdmin", fields: [adminId], references: [id], onDelete: Restrict)

  user User @relation("TokenLogUser", fields: [userId], references: [id], onDelete: Restrict)

  tokenGrant TokenGrant? @relation(fields: [tokenGrantId], references: [id], onDelete: Restrict)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@index([userId, createdAt])
  @@index([tokenGrantId])
  @@index([transactionType])
  @@map("token_logs")
}
